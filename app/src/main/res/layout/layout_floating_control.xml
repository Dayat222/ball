<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controlBarRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- 1. Full Toolbar Container -->
    <LinearLayout
        android:id="@+id/fullToolbarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Toolbar Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_control_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <!-- Drag Handle Area -->
            <TextView
                android:id="@+id/btnDragHandle"
                android:layout_width="28dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="@string/control_drag_handle"
                android:textColor="@color/cyan_accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Quick-Ghost (4s Auto-Hide) Button -->
            <TextView
                android:id="@+id/btnQuickGhost"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="@string/control_ghost"
                android:textColor="@color/yellow_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Hide / Show Canvas Toggle Button -->
            <TextView
                android:id="@+id/btnToggleVisibility"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="@string/control_hide"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Mode Cycle Button -->
            <TextView
                android:id="@+id/btnCycleMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="@string/control_mode_auto"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Calibration Mode Toggle Button -->
            <TextView
                android:id="@+id/btnToggleCalibrate"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="@string/control_calibrate"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Reset Calibration Boundary to Center (Landscape & Portrait safe) -->
            <TextView
                android:id="@+id/btnResetBound"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/control_reset_bound"
                android:textColor="@color/yellow_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 6-Pocket Radial Lines Toggle Button -->
            <TextView
                android:id="@+id/btnToggleSixLines"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_btn_active"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/control_six_lines"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Line Settings (Thickness / Opacity) Toggle Button -->
            <TextView
                android:id="@+id/btnToggleSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:text="@string/control_settings"
                android:textColor="@color/cyan_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Minimize Button -->
            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="30dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:text="@string/control_minimize"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Close / Stop Button -->
            <TextView
                android:id="@+id/btnCloseOverlay"
                android:layout_width="30dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_btn"
                android:gravity="center"
                android:text="@string/control_close"
                android:textColor="@color/red_danger"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Sub-Panel: Line Thickness & Opacity Sliders -->
        <LinearLayout
            android:id="@+id/panelSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_control_bar"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <!-- Line Thickness Slider -->
            <TextView
                android:id="@+id/tvThicknessValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thickness: 3.5 dp"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekThickness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="30"
                android:min="1"
                android:progress="7"
                android:progressTint="@color/cyan_accent"
                android:thumbTint="@color/cyan_accent" />

            <!-- Line Opacity Slider -->
            <TextView
                android:id="@+id/tvOpacityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Opacity: 86%"
                android:textColor="@color/yellow_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekOpacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="255"
                android:min="25"
                android:progress="220"
                android:progressTint="@color/yellow_accent"
                android:thumbTint="@color/yellow_accent" />

            <!-- Line Color Section -->
            <TextView
                android:id="@+id/tvColorTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_line_color"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Row: Circular Preset Swatches and Color Preview -->
            <LinearLayout
                android:id="@+id/rowPresetColors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/btnColorWhite"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/btnColorCyan"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/btnColorYellow"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/btnColorGreen"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/btnColorRed"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp" />

                <View
                    android:id="@+id/btnColorMagenta"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="8dp" />

                <!-- Current Color Preview Indicator -->
                <View
                    android:id="@+id/viewColorPreview"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- Hue Spectrum Slider (0 - 360) -->
            <TextView
                android:id="@+id/tvHueValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Spectrum Hue: 185°"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <SeekBar
                android:id="@+id/seekHue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="360"
                android:min="0"
                android:progress="185" />

        </LinearLayout>

    </LinearLayout>

    <!-- 2. Minimized Floating Capsule Bar (Draggable Mini Bar with Quick ON/OFF Switch & Expand Button) -->
    <LinearLayout
        android:id="@+id/minimizedCapsule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_control_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:visibility="gone">

        <!-- Mini Drag Grip Handle -->
        <TextView
            android:id="@+id/btnMiniDrag"
            android:layout_width="22dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/control_drag_handle"
            android:textColor="@color/cyan_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Mini Quick ON / OFF Switch -->
        <TextView
            android:id="@+id/btnMiniToggleOnOff"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_btn_on"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/control_on"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Mini Expand Button [+] -->
        <TextView
            android:id="@+id/btnMiniExpand"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_control_btn"
            android:gravity="center"
            android:text="@string/control_maximize"
            android:textColor="@color/cyan_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
